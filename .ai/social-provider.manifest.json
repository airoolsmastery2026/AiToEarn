{
  "schemaVersion": "1.0",
  "provider": "aitoearn",
  "role": "social-execution",
  "transport": {
    "preferred": "mcp",
    "international": "https://aitoearn.ai/api/unified/mcp",
    "china": "https://aitoearn.cn/api/unified/mcp"
  },
  "policies": {
    "zeroCostFirst": true,
    "paidProviderFallback": false,
    "autonomousEngagementDefault": false,
    "blindSideEffectRetry": false,
    "secretsInGit": false
  },
  "operations": {
